{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["astro/client"],
    "skipLibCheck": true
  },
  "include": [
    "site/src/scripts/**/*.ts",
    "site/src/scripts/**/*.tsx",
    "site/src/components/**/*.tsx"
  ]
}
