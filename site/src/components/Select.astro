---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  options: { value: string; label: string }[];
  value: string;
  prefix?: string;
}
const { id, label, options, value, prefix } = Astro.props;
---

<div class="select-control" data-select>
  <label class="sr-only" id={`${id}-label`} for={id}>{label}</label>
  <select id={id}>
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))
    }
  </select>
  <button
    class="select-trigger"
    type="button"
    aria-labelledby={`${id}-label ${id}-value`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-options`}
    hidden
  >
    <span class="select-value-wrap">
      {
        prefix && (
          <>
            <span class="select-prefix" aria-hidden="true">
              {prefix}
            </span>{' '}
          </>
        )
      }
      <span class="select-value" id={`${id}-value`}
        >{options.find((option) => option.value === value)?.label}</span
      >
    </span>
    <Icon name="chevron" size={16} strokeWidth={1.8} />
  </button>
  <div
    class="select-options"
    id={`${id}-options`}
    role="listbox"
    aria-label={label}
    hidden
  >
    {
      options.map((option) => (
        <button
          type="button"
          role="option"
          aria-selected={option.value === value}
          data-value={option.value}
          tabindex="-1"
        >
          <span class="select-option-label">{option.label}</span>
          <span class="select-option-check" aria-hidden="true">
            <Icon name="check" size={14} strokeWidth={2} />
          </span>
        </button>
      ))
    }
  </div>
</div>
<script src="../scripts/select.ts"></script>
