---
import {
  ArrowRight,
  Check,
  ChevronDown,
  Clock,
  Download,
  EighthNotes,
  ExternalLink,
  Heart,
  Link,
  Maximize2,
  Minus,
  Plus,
  Upload,
  X,
  type IconNode,
} from 'lucide';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
}
const { name, size = 24, strokeWidth = 1.75 } = Astro.props;
const icons: Record<string, IconNode> = {
  download: Download,
  arrow: ArrowRight,
  clock: Clock,
  music: EighthNotes,
  link: Link,
  heart: Heart,
  external: ExternalLink,
  expand: Maximize2,
  close: X,
  minus: Minus,
  plus: Plus,
  chevron: ChevronDown,
  check: Check,
  upload: Upload,
};
const nodes = icons[name] || ArrowRight;
const escapeAttr = (value: string | number) =>
  String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;');
const inner = nodes
  .map(([tag, attrs]) => {
    const serialized = Object.entries(attrs)
      .map(([key, value]) => `${key}="${escapeAttr(value)}"`)
      .join(' ');
    return `<${tag} ${serialized}/>`;
  })
  .join('');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
