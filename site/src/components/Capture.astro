---
import Icon from './Icon.astro';
import { route } from '../lib/release';
import evidence from '../../../docs/screenshot-evidence.json';
import features from '../../../docs/feature-capture-evidence.json';

interface Props {
  image: string;
  mobile?: string;
  title: string;
  alt: string;
  variant?: string;
  themed?: boolean;
}

const { image, mobile, title, alt, variant = '', themed = false } = Astro.props;
const findCapture = (name: string) => {
  const capture = [...evidence.screenshots, ...features.screenshots].find(
    (item) => item.file === name,
  );
  if (!capture) throw new Error(`Missing verified capture: ${name}`);
  return capture;
};
const desktop = findCapture(image);
const narrow = mobile ? findCapture(mobile) : null;
const themeSources = themed
  ? ['charcoal', 'light', 'oled'].flatMap((theme) => [
      ...(mobile
        ? [
            {
              theme,
              size: 'mobile',
              capture: findCapture(mobile.replace('-charcoal', `-${theme}`)),
            },
          ]
        : []),
      {
        theme,
        size: 'desktop',
        capture: findCapture(image.replace('-charcoal', `-${theme}`)),
      },
    ])
  : [];
---

<figure
  class:list={['product-capture', variant]}
  style={variant === 'capture-controls'
    ? `--capture-native-width: ${desktop.cssWidth}px`
    : undefined}
>
  <a
    class="capture-link"
    href={route(`screenshots/${image}`)}
    target="_blank"
    rel="noopener noreferrer"
    data-capture
    data-title={title}
    data-native-width={desktop.cssWidth}
    data-native-height={desktop.cssHeight}
    aria-label={`Enlarge screenshot: ${title}`}
  >
    <div class="capture-surface">
      <picture>
        {
          themeSources.map(({ theme, size, capture }) => (
            <source
              data-theme={theme}
              data-size={size}
              data-native-width={capture.cssWidth}
              data-native-height={capture.cssHeight}
              media={
                theme === 'charcoal'
                  ? size === 'mobile'
                    ? '(max-width: 600px)'
                    : 'all'
                  : 'not all'
              }
              srcset={route(`screenshots/${capture.file}`)}
              width={capture.width}
              height={capture.height}
            />
          ))
        }
        {
          narrow && !themed && (
            <source
              media="(max-width: 600px)"
              srcset={route(`screenshots/${mobile}`)}
              width={narrow.width}
              height={narrow.height}
            />
          )
        }
        <img
          src={route(`screenshots/${image}`)}
          width={desktop.width}
          height={desktop.height}
          loading="lazy"
          decoding="async"
          alt={alt}
        />
      </picture>
    </div>
    <span class="capture-open"
      >Enlarge screenshot<Icon name="expand" size={18} /></span
    >
  </a>
</figure>
