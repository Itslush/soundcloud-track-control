---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import TimelineDemo from '../components/TimelineDemo.astro';
import Capture from '../components/Capture.astro';
import CaptureViewer from '../components/CaptureViewer.astro';
import { installUrl, rpcPluginUrl, route, release } from '../lib/release';

const groups = [
  {
    id: 'speed',
    label: 'Speed & Pitch',
    items: [
      {
        id: 'player',
        title: 'Set the speed and pitch you want',
        text: 'Slow a track down or speed it up from 0.25× to 4×. Shift pitch independently, or lock the original key as speed changes.',
        images: ['player'],
        alt: 'Player bar tempo controls at 0.9× with a -3 semitone key shift.',
        variant: 'capture-player',
      },
      {
        id: 'styles',
        title: 'Use a slider, dial or vertical fader',
        text: 'Switch control styles anytime under Appearance, and pick your arrow step increment from 0.001× to 1×.',
        images: ['dial', 'vertical'],
        alt: 'Dial and vertical fader tempo controls with a separate key shift field.',
        variant: 'capture-controls',
      },
    ],
  },
  {
    id: 'timelines',
    label: 'Timelines & Sets',
    items: [
      {
        id: 'tempo',
        title: 'Draw speed changes over time',
        text: 'Schedule speed transitions with instant, linear, ease, or smooth curves across the track timeline.',
        images: ['tempo'],
        alt: 'Timeline editor showing a three-point speed curve, fades and editable bounds.',
      },
      {
        id: 'pitch',
        title: 'Draw pitch changes too',
        text: 'Automate semitone changes independently on the Pitch lane and save or share the complete timeline.',
        images: ['pitch'],
        alt: 'Pitch automation lane with fractional semitone nodes and transitions.',
      },
      {
        id: 'shared',
        title: 'Share without requiring an install',
        text: 'Send a tracked setup link so anyone can listen to your speed and pitch automation on the web or compare with the original.',
        images: ['shared'],
        alt: 'Shared-track website player displaying received tempo and pitch automation.',
      },
      {
        id: 'set',
        title: 'Join tracks into one shared set',
        text: 'Combine 2 to 10 tracks with separate speeds, key shifts, and crossfades into one shareable mix or playable preview.',
        images: ['set'],
        alt: 'Shared set builder with per-track tempo, key shift and crossfade overlap controls.',
      },
    ],
  },
  {
    id: 'mixer',
    label: 'Mixer & DJ',
    items: [
      {
        id: 'mixer',
        title: 'Mix two decks live',
        text: 'Play two SoundCloud tracks or local files side by side with a crossfader, 3-band EQ, filter, per-deck gain, and BPM sync.',
        images: ['mixer'],
        alt: 'Two-deck mixer with crossfader, Gain, Volume cap, 3-band EQ, filter and BPM sync.',
      },
      {
        id: 'dj',
        title: 'One-click DJ routing pills',
        text: 'Toggle DJ click-to-deck mode (Alt+Shift+D) to place +A and +B load pills next to every SoundCloud play button.',
        images: ['dj'],
        alt: 'SoundCloud track row with +A and +B DJ routing pills beside the play button.',
      },
      {
        id: 'crossfade',
        title: 'Automatic queue crossfade',
        text: 'Blend queued tracks automatically over 1–10 seconds with optional outgoing bass-swap, Cue 1 entry and live diagnostics.',
        images: ['crossfade'],
        alt: 'Audio tab crossfade controls, bass-swap toggle, Cue 1 entry and diagnostics.',
      },
    ],
  },
  {
    id: 'audio',
    label: 'Audio & FX',
    items: [
      {
        id: 'fx',
        title: 'Master FX, A-B loops, cues & export',
        text: 'Shape live playback with a bass shelf, DJ filter, and slowed reverb rooms. Save presets with undo, mark A-B loops and hot cues, or render the track locally to WAV.',
        images: ['fx'],
        alt: 'FX & DJ tab with Master FX sliders, presets, A-B loop buttons, 4 hot cues and WAV export.',
      },
      {
        id: 'output',
        title: 'Custom boost cap & peak protection',
        text: 'Soften loud peaks when shifting pitch, dial output gain, and type your own Volume cap in dB past the slider limit.',
        images: ['output'],
        alt: 'Audio tab Output level slider, customizable Volume cap box and Peak protection.',
      },
    ],
  },
  {
    id: 'customize',
    label: 'Customize & Library',
    items: [
      {
        id: 'saved',
        title: 'Per-track library & backups',
        text: 'Save speed, pitch, and timelines per track. Filter the list, undo accidental removals, and back everything up as JSON.',
        images: ['saved'],
        alt: 'Tracks tab with searchable saved tracks, per-track speeds and backup disclosure.',
      },
      {
        id: 'appearance',
        title: 'Themes, layout & Pin mode',
        text: 'Switch SoundCloud, Light, Charcoal, or OLED themes, choose a control style, adjust star motion, or Pin settings open while scrubbing.',
        images: ['appearance'],
        alt: 'Appearance tab showing control style, default increment, theme selector and star motion.',
      },
      {
        id: 'shortcuts',
        title: 'Custom keyboard shortcuts',
        text: 'Rebind or clear any global hotkey for speed steps, Deck A/B routing, A-B loops, hot cues, BPM tap, and WAV export.',
        images: ['shortcuts'],
        alt: 'Shortcuts tab with interactive chord buttons, Clear controls and Reset defaults.',
      },
    ],
  },
];
---

<Page>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Change speed and pitch <br />on SoundCloud.</h1><p>
        Remember speeds per track, automate changes over time, mix two decks
        live, and share links friends can play.
      </p><div class="hero-actions">
        <a class="button primary" href={installUrl}
          ><Icon name="download" />Install userscript</a
        ><a class="text-link" href="#install">Setup guide</a>
      </div>
      <p class="hero-desktop-note">
        Using soundcloud-rpc? <a class="text-link" href="#desktop-install"
          >Desktop plugin</a
        >
      </p>
    </div>
    <TimelineDemo />
  </section>
  <section
    class="product-proof feature-showcase shell"
    aria-labelledby="proof-title"
  >
    <div class="feature-showcase-header">
      <div>
        <h2 id="proof-title">Built for listening, mixing and sharing</h2>
        <p>
          Everyday speed, pitch, timeline, mixer, and library tools inside
          SoundCloud.
        </p>
      </div>
    </div>
    <div class="feature-tabs" role="tablist" aria-label="Feature categories">
      {
        groups.map((group, index) => (
          <button
            class="feature-tab"
            type="button"
            role="tab"
            id={`tab-${group.id}`}
            data-feature-tab={group.id}
            aria-controls={`panel-${group.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
          >
            {group.label}
          </button>
        ))
      }
    </div>
    {
      groups.map((group, index) => (
        <div
          class="feature-panel"
          id={`panel-${group.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${group.id}`}
          data-feature-panel={group.id}
          hidden={index > 0}
        >
          {group.items.map((feature) => (
            <article class="proof-row" id={`feature-${feature.id}`}>
              <div class="proof-copy">
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
                {feature.id === 'shared' && (
                  <a class="text-link" href={route('guide/#sharing')}>
                    How sharing works
                  </a>
                )}
                {feature.id === 'set' && (
                  <div class="set-links">
                    <a class="text-link" href={route('set/')}>
                      Build a set
                    </a>
                    <a class="text-link" href={route('mixer/')}>
                      Two-deck mixer
                    </a>
                  </div>
                )}
                {feature.id === 'mixer' && (
                  <div class="set-links">
                    <a class="text-link" href={route('mixer/')}>
                      Open live mixer
                    </a>
                    <a class="text-link" href={route('guide/#mixer')}>
                      DJ guide
                    </a>
                  </div>
                )}
              </div>
              <div
                class:list={[
                  'proof-images',
                  { 'proof-control-styles': feature.images.length > 1 },
                ]}
              >
                {feature.images.map((image) => (
                  <Capture
                    image={`feature-${image}-charcoal.png`}
                    mobile={`feature-${image}-charcoal-mobile.png`}
                    themed
                    title={
                      feature.images.length > 1
                        ? `${image === 'dial' ? 'Dial' : 'Vertical fader'} tempo control`
                        : feature.title
                    }
                    variant={feature.variant}
                    alt={feature.alt}
                  />
                ))}
              </div>
            </article>
          ))}
        </div>
      ))
    }
  </section>
  <section
    class="install-section shell"
    id="install"
    aria-labelledby="install-title"
  >
    <div>
      <h2 id="install-title">Install Track Control</h2><a
        class="text-link"
        href={route('guide/')}>Full setup guide</a
      >
      <div class="rpc-install" id="desktop-install">
        <h3>Using soundcloud-rpc?</h3>
        <div class="hero-actions">
          <a
            class="button"
            href={rpcPluginUrl}
            download="soundcloud_tempo_control.js"
            ><Icon name="download" />Download desktop plugin v{
              release.version
            }</a
          >
          <a class="text-link" href={route('guide/#desktop')}>Desktop setup</a>
        </div>
        <p>
          In the app, open F1 → Plugins → Open folder, add the file, then
          refresh and enable it. Reload SoundCloud before playing.
        </p>
      </div>
    </div>
    <ol class="install-steps">
      <li>
        <h3>Get Violentmonkey</h3><p>
          A userscript manager runs Track Control in your browser.
        </p><a
          href="https://violentmonkey.github.io/get-it/"
          target="_blank"
          rel="noopener noreferrer"
          >Get Violentmonkey<Icon name="external" size={15} /></a
        >
      </li>
      <li>
        <h3>Install Track Control</h3><p>
          Open the script, then confirm the installation in your manager.
        </p><a href={installUrl}
          >Install v{release.version}<Icon name="download" size={16} /></a
        >
      </li>
      <li>
        <h3>Open SoundCloud</h3><p>
          Reload the page and choose a track. The tempo slider sits in the
          player.
        </p><a
          href="https://soundcloud.com/"
          target="_blank"
          rel="noopener noreferrer"
          >Open SoundCloud<Icon name="external" size={15} /></a
        >
      </li>
    </ol>
  </section>
  <CaptureViewer />
  <noscript
    ><style>
      .feature-showcase [role='tabpanel'][hidden] {
        display: block !important;
      }
    </style></noscript
  >
  <script src="../scripts/feature-tabs.ts"></script>
</Page>
