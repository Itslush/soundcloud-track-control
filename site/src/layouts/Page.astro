---
import '@fontsource-variable/mulish';
import '../styles/site.css';
import '../styles/preview.css';
import Logo from '../components/Logo.astro';
import SpaceAccent from '../components/SpaceAccent.astro';
import Donations from '../components/Donations.astro';
import { release, route } from '../lib/release';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Change playback speed on SoundCloud. Save speeds for individual tracks and share tempo timelines.',
} = Astro.props;
const pageTitle = title
  ? `${title} · SoundCloud Tempo Control`
  : 'SoundCloud Tempo Control';
const canonical = release.siteUrl
  ? new URL(Astro.url.pathname, release.siteUrl).href
  : null;
const shareIcon = release.siteUrl
  ? new URL('share-icon.png', release.siteUrl).href
  : null;
const links = [
  ['Download', ''],
  ['Updates', 'updates/'],
  ['Help', 'guide/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('soundcloud.tempo.siteTheme');
        if (theme === 'light' || theme === 'oled')
          document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={route('favicon.svg')} />
    {
      canonical && shareIcon && (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:site_name" content="SoundCloud Tempo Control" />
          <meta property="og:image" content={shareIcon} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="512" />
          <meta property="og:image:height" content="512" />
          <meta
            property="og:image:alt"
            content="Tempo Control waveform and slider icon"
          />
          <meta name="twitter:card" content="summary" />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={shareIcon} />
          <meta
            name="twitter:image:alt"
            content="Tempo Control waveform and slider icon"
          />
        </>
      )
    }
  </head>
  <body>
    <SpaceAccent />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner shell">
        <a class="brand" href={route()} aria-label="Tempo Control home"
          ><Logo /><strong>Tempo Control</strong></a
        >
        <nav aria-label="Main navigation">
          {
            links.map(([label, path]) => (
              <a
                href={route(path)}
                aria-current={
                  Astro.url.pathname === route(path) ? 'page' : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <Donations />
    <details class="site-appearance shell" hidden>
      <summary
        >Appearance <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          aria-hidden="true"
          ><path
            d="m4 6 4 4 4-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"></path></svg
        ></summary
      >
      <div class="site-theme-options" role="group" aria-label="Website theme">
        {
          [
            ['light', 'Light'],
            ['charcoal', 'Charcoal'],
            ['oled', 'OLED'],
          ].map(([value, label]) => (
            <button
              class="button"
              type="button"
              data-site-theme={value}
              aria-pressed={value === 'charcoal' ? 'true' : 'false'}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                aria-hidden="true"
              >
                <path
                  d="m3 8 3 3 7-7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
              {label}
            </button>
          ))
        }
      </div>
      <p id="site-theme-status" role="status"></p>
      <button
        class="button"
        id="site-star-motion"
        type="button"
        aria-pressed="false">Animate stars</button
      >
      <p id="site-star-status" role="status"></p>
    </details>
    <footer class="site-footer shell">
      <p>Unofficial. Not affiliated with SoundCloud.</p>
      <nav aria-label="Footer navigation">
        <a href={route('privacy/')}>Privacy</a>{
          release.repositoryUrl && (
            <a href={release.repositoryUrl} rel="noopener noreferrer">
              Source
            </a>
          )
        }<a href={route('guide/')}>Help</a>
      </nav>
    </footer>
  </body>
</html>

<script src="../scripts/site-theme.ts"></script>
